[packaging]
exclude=
    # Remove CI files.
    .coveragerc
    .pre-commit-config.yaml
    azure-pipelines
    azure-pipelines.yml
    # Remove unneeded files.
    resources/python/build
    resources/python/pipelines
    resources/python/*.bat
    resources/python/*.md
    resources/python/*.ps1
    resources/python/*.py
    resources/python/*.sh
    resources/python/*.txt
    tests
